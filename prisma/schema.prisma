generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

// One row per play, parsed from Spotify's "Extended Streaming History" export.
// trackUri is the real Spotify track ID when present (podcast episodes don't have one).
model PlayEvent {
  id          String   @id @default(cuid())
  playedAt    DateTime
  msPlayed    Int
  trackUri    String?
  trackName   String?
  artistName  String?
  albumName   String?
  platform    String?
  reasonStart String?
  reasonEnd   String?
  shuffle     Boolean?
  skipped     Boolean?
  offline     Boolean?
  isPodcast   Boolean  @default(false)
  isAudiobook Boolean  @default(false)
  importedAt  DateTime @default(now())
  // Non-nullable fallback for trackUri (SQL NULL != NULL means a nullable column
  // in a unique constraint silently stops deduping rows that lack it).
  dedupeKey   String

  @@unique([dedupeKey, playedAt])
  @@index([playedAt])
  @@index([artistName])
}

// Stores a refresh token server-side so the cron sync job (no browser, no cookies)
// can authenticate as you. The browser session still uses httpOnly cookies as normal;
// this is only for the background job.
model SpotifyAccount {
  id                   String   @id @default(cuid())
  spotifyUserId        String   @unique
  refreshToken         String
  accessToken          String
  accessTokenExpiresAt DateTime
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

// Shared cache for public, near-static Spotify metadata (album art, popularity, genres, follower
// counts). The Extended Streaming History export has none of this, so it's otherwise re-resolved
// live from Spotify on every request. This data is identical for any caller (Spotify's public
// catalog, not per-user), so one shared table with a TTL-based refresh (see lib/spotifyCache.ts)
// is correct — not a permanent cache, since images/followers/genres do drift slowly.
model CachedTrack {
  id               String   @id // plain Spotify track id, not the "spotify:track:" URI
  name             String
  popularity       Int
  durationMs       Int
  albumId          String
  albumName        String
  // "YYYY" | "YYYY-MM" | "YYYY-MM-DD" depending on Spotify's release_date_precision — kept as a
  // plain string, never DateTime, so a partial date never fails to parse.
  albumReleaseDate String
  albumTotalTracks Int?
  albumImages      Json // SpotifyImage[]
  // The track's artist credits ({id,name}[]) — needed to cross-reference an artist's real
  // Spotify id from a representative track, not just the track's own metadata.
  artists          Json
  externalUrl      String?
  fetchedAt        DateTime @default(now()) @updatedAt

  @@index([fetchedAt])
}

model CachedArtist {
  id          String   @id
  name        String
  genres      Json // string[]
  popularity  Int
  followers   Int
  images      Json // SpotifyImage[]
  externalUrl String?
  fetchedAt   DateTime @default(now()) @updatedAt

  @@index([fetchedAt])
}
