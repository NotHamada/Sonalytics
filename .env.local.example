# Copy this file to .env.local and fill in your values.
# Get these from https://developer.spotify.com/dashboard after creating an app.

SPOTIFY_CLIENT_ID=your_client_id_here
SPOTIFY_CLIENT_SECRET=your_client_secret_here

# Must exactly match a Redirect URI registered in your Spotify app settings.
# Use http://127.0.0.1 (not localhost) for local development.
SPOTIFY_REDIRECT_URI=http://127.0.0.1:3000/api/auth/callback

# Postgres (e.g. Neon via the Vercel Marketplace). Pooled URL for the app, unpooled
# for Prisma migrations (pgbouncer's pooled mode can't run them).
DATABASE_URL="postgresql://user:password@host-pooler.region.aws.neon.tech/dbname?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://user:password@host.region.aws.neon.tech/dbname?sslmode=require"

# Random secret shared with Vercel's CRON_SECRET env var, so only Vercel's scheduler
# can trigger /api/cron/sync. Generate one with: openssl rand -hex 32
CRON_SECRET=
