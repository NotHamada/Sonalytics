# Copy this file to .env.local and fill in your values.
# Get these from https://developer.spotify.com/dashboard after creating an app.

SPOTIFY_CLIENT_ID=your_client_id_here
SPOTIFY_CLIENT_SECRET=your_client_secret_here

# Must exactly match a Redirect URI registered in your Spotify app settings.
# Use http://127.0.0.1 (not localhost) for local development.
SPOTIFY_REDIRECT_URI=http://127.0.0.1:3000/api/auth/callback
